{
  "name": "skykerf-studio",
  "productName": "SkyKerf_Studio",
  "version": "0.3.0",
  "description": "Open-source CAD/CAM for laser cutters and CNC routers: drawing on real sheets, nesting, toolpaths, postprocessors with validation, G-code preview, machine control, parametric generators, 3D model slicing.",
  "main": "main.js",
  "license": "MIT",
  "author": {
    "name": "SkyKerf_Studio contributors",
    "email": "skykerf-studio@users.noreply.github.com"
  },
  "homepage": "https://github.com/skysyndicatecorner/SkyKerf_Studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/skysyndicatecorner/SkyKerf_Studio.git"
  },
  "bugs": {
    "url": "https://github.com/skysyndicatecorner/SkyKerf_Studio/issues"
  },
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test \"tests/*.test.js\"",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "^44.6.0",
    "electron-builder": "^26.16.0"
  },
  "build": {
    "appId": "org.kerfstudio.app",
    "productName": "SkyKerf_Studio",
    "executableName": "skykerf-studio",
    "copyright": "Copyright © 2026 SkyKerf_Studio contributors",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "licenses/**/*"
    ],
    "fileAssociations": [
      {
        "ext": "kerf",
        "name": "SkyKerf_Studio Project",
        "description": "SkyKerf_Studio project",
        "mimeType": "application/x-skykerf-project",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SkyKerf_Studio",
      "artifactName": "SkyKerf_Studio-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "SkyKerf_Studio-Portable-${version}.${ext}"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Graphics",
      "icon": "build/icon.png",
      "synopsis": "CAD/CAM for laser cutters and CNC routers",
      "maintainer": "SkyKerf_Studio contributors <skykerf-studio@users.noreply.github.com>",
      "artifactName": "SkyKerf_Studio-${version}-${arch}.${ext}"
    },
    "deb": {
      "packageName": "skykerf-studio"
    }
  }
}
